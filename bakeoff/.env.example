# Any subset: models whose key is missing are skipped.
OPENAI_API_KEY=          # gpt-image-2 (the same key as checker-bot works)
GEMINI_API_KEY=          # nano-banana-pro, nano-banana-2 (the same key as checker-bot works)
FAL_KEY=                 # flux-2-pro, qwen-edit-2511, seedream-5-lite (fal.ai/dashboard/keys)
FIREWORKS_API_KEY=       # kontext-pro-fireworks (the key checker-bot's gpt-oss scorer uses)
OPENROUTER_API_KEY=      # muse-image (Meta), once enabled in models.json
